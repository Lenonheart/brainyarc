{
    "layer": "top",
    "height": 38,
    "spacing": 8,
    "reload_style_on_change": true,

    "modules-left": ["hyprland/workspaces","cpu","disk","memory"],
    "modules-center": ["clock"],
    "modules-right": ["bluetooth","network","pulseaudio","battery"],
    "include": [
        "./modules/battery.jsonc",
        "./modules/clock.jsonc",
        "./modules/cpu.jsonc",
        "./modules/memory.jsonc",
        "./modules/network.jsonc",
        "./modules/bluetooth.jsonc",
        "./modules/audio.jsonc",
        "./modules/workspaces.jsonc",
        "./modules/disk.jsonc"
    ]
}